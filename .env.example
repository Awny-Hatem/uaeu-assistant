# Primary AI provider for chat replies.
# Put the real key in .env.local or deployment secrets, never in source code.
OPENAI_API_KEY=your-openai-api-key

# Optional provider settings.
# AI_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_MAX_OUTPUT_TOKENS=900
# GEMINI_MAX_OUTPUT_TOKENS=900
# AI_PROVIDER_TIMEOUT_MS=20000

# Optional Gemini provider and embedding ingest support.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_SEARCH=enabled
# Cross-provider fallback is disabled unless explicitly enabled.
# AI_PROVIDER_FALLBACK=enabled

# Local browser quota defaults exposed to the client.
# NEXT_PUBLIC_GUEST_QUESTION_LIMIT=10
# NEXT_PUBLIC_STANDARD_ACCOUNT_QUESTION_LIMIT=50
# Self-entered university email does not grant a verified identity or higher allowance.
# Browser allowances are prototype UX limits, not server-enforced account quotas.

# Optional SQLite paths for local/self-hosted deployments.
# Vercel uses temporary /tmp storage automatically.
# CHATBOT_DATA_DIR=./data
# CHATBOT_DB_PATH=./data/chatbot.db

# Conversation history defaults to browser localStorage.
# Set this only if you have a privacy policy and explicit student consent.
# SERVER_CHAT_HISTORY=enabled

# Optional admin dashboard lock for /admin/analytics.
# Use a long random value and send it as the x-admin-token request header.
# ADMIN_ANALYTICS_TOKEN=your-long-random-admin-token

# Required for account/session features. Use a dedicated random secret of at least 32 characters.
# Generate one per environment, for example: openssl rand -base64 48
# AUTH_COOKIE_SECRET=replace-with-a-unique-random-secret

# Deployment contract. Default is a clearly labelled team prototype.
# CHATBOT_DEPLOYMENT_MODE=prototype
# Explicit production mode fails closed until durable managed identity and shared limits exist.
# A persistent, self-hosted SQLite deployment may opt into registered revocable sessions.
# Do not enable this for Vercel temporary storage or an in-memory test database.
# CHATBOT_DURABLE_STORAGE=enabled
# Trust forwarded IP headers only behind a proxy you control and have verified.
# TRUST_PROXY_HEADERS=enabled
