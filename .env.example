# ── Database (required) ──────────────────────────────────────────────────────
# Persistence runs on a libSQL/Turso database so it works on Vercel's
# serverless (read-only, ephemeral) filesystem. Create one for free:
#   1. npm i -g @turso/cli   (or: brew install tursodatabase/tap/turso)
#   2. turso auth signup
#   3. turso db create uaeu-assistant
#   4. turso db show uaeu-assistant --url        -> TURSO_DATABASE_URL
#   5. turso db tokens create uaeu-assistant     -> TURSO_AUTH_TOKEN
# Set both in Vercel → Project → Settings → Environment Variables too.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── AI (required for replies beyond the cached FAQ) ──────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# Optional: override default models
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
