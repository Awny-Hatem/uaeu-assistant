# Primary AI provider for chat replies.
# Put the real key in .env.local or deployment secrets, never in source code.
OPENAI_API_KEY=your-openai-api-key

# Optional provider settings.
# AI_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_MAX_OUTPUT_TOKENS=900

# Optional Gemini fallback and embedding ingest support.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_SEARCH=enabled

# Local browser quota defaults exposed to the client.
# NEXT_PUBLIC_GUEST_QUESTION_LIMIT=10
# NEXT_PUBLIC_STANDARD_ACCOUNT_QUESTION_LIMIT=50
# NEXT_PUBLIC_UAEU_ACCOUNT_QUESTION_LIMIT=200

# Optional SQLite paths for local/self-hosted deployments.
# Vercel uses temporary /tmp storage automatically.
# CHATBOT_DATA_DIR=./data
# CHATBOT_DB_PATH=./data/chatbot.db

# Conversation history defaults to browser localStorage.
# Set this only if you have a privacy policy and explicit student consent.
# SERVER_CHAT_HISTORY=enabled

# Optional admin dashboard lock for /admin/analytics.
# Use a long random value and send it as the x-admin-token request header.
# ADMIN_ANALYTICS_TOKEN=your-long-random-admin-token
