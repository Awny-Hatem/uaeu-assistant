{
  "name": "uaeu-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "tsx tests/prototype-checks.ts",
    "test:http": "node tests/http-smoke.mjs",
    "test:browser": "playwright test",
    "test:pipeline": "tsx tests/pipeline-regressions.ts && tsx tests/independent-scope-regressions.ts && tsx tests/admission-calendar-regressions.ts",
    "test:semantic": "tsx tests/semantic-fault-checks.ts",
    "test:canonical": "tsx tests/canonical-rendering-checks.ts",
    "test:content": "tsx tests/academic-content-checks.ts && tsx tests/service-content-checks.ts && tsx tests/knowledge-portability-checks.ts",
    "test:grounding": "tsx tests/source-evidence-fault-checks.ts && tsx tests/claim-verifier-fault-checks.ts",
    "test:source-response": "tsx tests/source-response-checks.ts",
    "test:deadline": "tsx tests/provider-deadline-checks.ts && tsx tests/provider-retry-checks.ts",
    "test:integrity": "node tests/evaluation-integrity-checks.mjs",
    "test:security": "tsx tests/ui-security-checks.ts && tsx tests/account-ownership-checks.ts",
    "test:offline": "npm test && npm run test:pipeline && npm run test:semantic && npm run test:canonical && npm run test:content && npm run test:grounding && npm run test:security && npm run test:source-response && npm run test:deadline && npm run test:integrity && npm run eval:common && npm run eval:alignment",
    "eval:alignment": "tsx scripts/evaluate-answer-alignment.ts",
    "eval:sources": "tsx scripts/check-source-urls.ts",
    "eval:common": "tsx scripts/evaluate-common-questions.ts",
    "eval:independent": "node scripts/evaluate-independent.mjs",
    "eval:report": "node scripts/render-evaluation-report.mjs",
    "start": "next start",
    "lint": "eslint",
    "ingest": "npx tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
